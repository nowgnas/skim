#!/usr/bin/env bash
set -euo pipefail
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" = /* ]] || SOURCE="$SOURCE_DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
source "$ROOT/lib/python.sh"
SKIM_CODEX_BIN_DIR="${HOME:-}/.local/share/skim-tools/node_modules/.bin"
if [[ -n "${HOME:-}" && -x "$SKIM_CODEX_BIN_DIR/codex" ]]; then
  export SKIM_CODEX_BIN="${SKIM_CODEX_BIN:-$SKIM_CODEX_BIN_DIR/codex}"
fi
PY="$(skim_find_python)" || exit 2
export PYTHONPATH="$ROOT/lib${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -P -m skim "$@"
