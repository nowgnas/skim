+                                        ('Retry-After: Thu, 01 Jan 1970 00:20:00 GMT', 429, 1200)]:
+            runner = lambda command, **kw: subprocess.CompletedProcess(command, 1, f'HTTP/2.0 {code} Error\n{headers}\n\n{{}}', '')
