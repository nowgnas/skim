@@ -6,3 +6,13 @@ from app.storage import activity, subscribers
 def notify_now(event):
     for person in subscribers.for_workspace(event.workspace_id):
         send(person.email, subject=event.title, template="event.txt", event=event)
+
+
+def send_daily_digest(workspace_id, day):
+    events = activity.for_day(workspace_id, day)
+    if not events:
+        return 0
+    people = [p for p in subscribers.for_workspace(workspace_id) if p.wants_digest]
+    for person in people:
+        send(person.email, subject=f"{len(events)} updates on {day:%b %d}", template="digest.txt", events=events)
+    return len(people)
