diff --git a/app/checkout.py b/app/checkout.py
index 22eb568..e18726c 100644
--- a/app/checkout.py
+++ b/app/checkout.py
@@ -3,14 +3,17 @@ from decimal import Decimal
 
 from app.storage import orders
 
+TIER_DISCOUNT = {"standard": Decimal("0"), "plus": Decimal("0.05"), "staff": Decimal("0.30")}
 
-def order_total(cart):
+
+def order_total(cart, tier="standard"):
     subtotal = sum(line.unit_price * line.quantity for line in cart.lines)
-    return (subtotal + cart.shipping_fee).quantize(Decimal("0.01"))
+    discounted = subtotal * (1 - TIER_DISCOUNT[tier])
+    return (discounted + cart.shipping_fee).quantize(Decimal("0.01"))
 
 
-def submit_order(cart, payments):
-    total = order_total(cart)
+def submit_order(cart, payments, tier="standard"):
+    total = order_total(cart, tier)
     order = orders.create(cart.customer_id, cart.lines, total)
     payments.charge(order.id, total)
     return order
